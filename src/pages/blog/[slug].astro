---
import Layout from '../../layouts/Layout.astro';

const postFiles = import.meta.glob<{
  frontmatter: { title: string; description: string; pubDate: string };
  default: any;
}>('../../content/blog/*.mdx', { eager: true });

export function getStaticPaths() {
  const paths = Object.entries(
    import.meta.glob('../../content/blog/*.mdx', { eager: true })
  ).map(([path, mod]: [string, any]) => ({
    params: { slug: path.split('/').pop()!.replace('.mdx', '') },
    props: {
      frontmatter: mod.frontmatter,
      Content: mod.default,
    },
  }));
  return paths;
}

const { frontmatter, Content } = Astro.props;
const pubDate = new Date(frontmatter.pubDate);
---

<Layout title={frontmatter.title}>
  <article class="blog-post">
    <header>
      <a href="/blog" class="back-link">&larr; Back to blog</a>
      <h1>{frontmatter.title}</h1>
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .blog-post header {
    margin-bottom: var(--space-xl);
  }
  .back-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--text-primary);
  }
  h1 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin: var(--space-md) 0 var(--space-sm);
    line-height: 1.3;
  }
  time {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Prose styles for blog content */
  .prose {
    line-height: 1.8;
    font-size: 1.05rem;
  }
  .prose :global(h2) {
    font-size: 1.4rem;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }
  .prose :global(h3) {
    font-size: 1.15rem;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }
  .prose :global(p) {
    margin-bottom: var(--space-md);
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: 1.5rem;
  }
  .prose :global(li) {
    margin-bottom: var(--space-xs);
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent-blue);
    margin: var(--space-md) 0;
    padding: var(--space-sm) var(--space-md);
    color: var(--text-secondary);
    font-style: italic;
  }
  .prose :global(pre) {
    background: #1e1e1e;
    color: #d4d4d4;
    padding: var(--space-md);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: var(--space-md);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .prose :global(code) {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.9em;
  }
  .prose :global(:not(pre) > code) {
    background: #f3f4f6;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: var(--text-primary);
  }
  .prose :global(a) {
    color: var(--accent-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(a:hover) {
    opacity: 0.8;
  }
  .prose :global(img) {
    max-width: 100%;
    border-radius: var(--radius-md);
    margin: var(--space-md) 0;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: var(--space-xl) 0;
  }
</style>
